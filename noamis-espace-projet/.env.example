# NOAMIS — Espace Projet : configuration (copier en .env ou définir dans l'hébergeur)
PORT=3100
APP_BASE_URL=https://espace.noamis.fr
NODE_ENV=production
# true derrière un proxy HTTPS (Nginx, Render, Fly…)
TRUST_PROXY=true
COOKIE_SECURE=true
DATABASE_PATH=./data/noamis.db
STORAGE_DIR=./data/storage
# false en production : n'injecte pas les comptes et données de démonstration
DEMO_MODE=false

# Envoi des e-mails (invitations et notifications) — à configurer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NOAMIS Espace Projet <no-reply@noamis.fr>"
